<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rustic Roots | Galeri</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="style.css">
    <style>
        /* Animasi tambahan khusus galeri */
        .gallery-item {
            opacity: 0;
            transform: translateY(30px) scale(0.95);
            transition: opacity 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1), transform 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }
        .gallery-item.revealed {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
        .gallery-item {
            position: relative;
            overflow: hidden;
            border-radius: 24px;
            cursor: pointer;
        }
        .gallery-item img {
            width: 100%;
            height: 280px;
            object-fit: cover;
            transition: transform 0.5s ease, filter 0.3s ease;
            display: block;
        }
        .gallery-item:hover img {
            transform: scale(1.08);
            filter: brightness(0.9);
        }
        .gallery-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
            color: white;
            padding: 20px;
            transform: translateY(100%);
            transition: transform 0.4s ease;
            text-align: center;
            font-weight: 500;
            backdrop-filter: blur(4px);
        }
        .gallery-item:hover .gallery-overlay {
            transform: translateY(0);
        }
        .gallery-overlay span {
            display: block;
            font-size: 1rem;
        }
        /* Styling untuk caption tetap jika overlay tidak aktif */
        .gallery-caption {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0,0,0,0.5);
            color: white;
            text-align: center;
            padding: 8px;
            font-size: 0.9rem;
            backdrop-filter: blur(4px);
            transition: opacity 0.3s;
        }
        .gallery-item:hover .gallery-caption {
            opacity: 0;
        }
        /* Penyesuaian agar overlay tidak bentrok */
        .gallery-item {
            position: relative;
        }
        .gallery-item .gallery-caption {
            position: absolute;
            bottom: 0;
            width: 100%;
            background: rgba(0,0,0,0.6);
            color: white;
            padding: 8px;
            text-align: center;
            transition: opacity 0.3s;
            pointer-events: none;
        }
        /* Responsive */
        @media (max-width: 768px) {
            .gallery-item img {
                height: 220px;
            }
            .gallery-overlay span {
                font-size: 0.8rem;
            }
        }
    </style>
</head>
<body>
<nav class="navbar" id="navbar">
    <div class="nav-container">
        <a href="index.html" class="logo">RUSTIC <span>ROOTS</span></a>
        <div class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></div>
        <ul class="nav-links" id="navLinks">
            <li><a href="index.html">Beranda</a></li>
            <li><a href="tentang.html">Tentang</a></li>
            <li><a href="galeri.html" class="active">Galeri</a></li>
            <li><a href="kontak.html">Kontak</a></li>
        </ul>
    </div>
</nav>

<div class="page-header" style="--bg-img: url('images/umum/galeri-bg.jpg'); background: linear-gradient(135deg, #4A3B2C20, #6B8C5C20), url('images/umum/galeri-bg.jpg') center/cover;">
    <div class="container">
        <h1>Galeri Karya</h1>
        <p>Inspirasi dari kayu dan batu alam</p>
    </div>
</div>

<div class="container">
    <div class="gallery-grid" id="galleryGrid">
        <!-- Data galeri akan di-generate dengan JavaScript agar seragam dan memudahkan penambahan -->
    </div>
</div>

<!-- Lightbox -->
<div id="lightbox" class="lightbox">
    <span class="close-lightbox" id="closeLightbox">&times;</span>
    <img class="lightbox-img" id="lightboxImg" src="" alt="Preview">
</div>

<footer>
    <div class="container">
        <div class="footer-content">
            <div><h3 style="font-family:'Playfair Display';">RUSTIC ROOTS</h3><p>Kerajinan Kayu & Batu Alam</p></div>
            <div class="social-links"><a href="#"><i class="fab fa-instagram"></i></a><a href="#"><i class="fab fa-facebook"></i></a><a href="#"><i class="fab fa-pinterest"></i></a></div>
        </div>
        <div class="copyright">&copy; 2025 RUSTIC ROOTS — Karya dari alam untuk rumah Anda.</div>
    </div>
</footer>

<script src="script.js"></script>
<script>
    // Data galeri (menggunakan gambar lokal dengan format .jpg sesuai permintaan sebelumnya)
    const galleryImages = [
        { src: "images/kayu/relief-1.jpg", caption: "Relief Kayu Jati Ukir", category: "Kayu" },
        { src: "images/kayu/meja-1.jpg", caption: "Meja Makan Trembesi", category: "Kayu" },
        { src: "images/batu/lampu-1.jpg", caption: "Lampu Meja Andesit", category: "Batu" },
        { src: "images/kayu/cutting-1.jpg", caption: "Cutting Board Walnut", category: "Kayu" },
        { src: "images/batu/patung-1.jpg", caption: "Patung Minimalis Paras", category: "Batu" },
        { src: "images/batu/vas-1.jpg", caption: "Vas Batu Palimanan", category: "Batu" },
        { src: "images/kayu/jam-1.jpg", caption: "Jam Dinding Kayu Oak", category: "Kayu" },
        { src: "images/batu/panel-1.jpg", caption: "Panel Dinding Batu Susun", category: "Batu" },
        // Tambahkan jika ada gambar lain
    ];

    const galleryGrid = document.getElementById('galleryGrid');

    function renderGallery() {
        galleryGrid.innerHTML = '';
        galleryImages.forEach((img, index) => {
            const item = document.createElement('div');
            item.className = 'gallery-item';
            // Tambahkan data atribut untuk animasi
            item.setAttribute('data-index', index);
            item.innerHTML = `
                <img src="${img.src}" alt="${img.caption}" loading="lazy">
                <div class="gallery-caption">${img.caption}</div>
                <div class="gallery-overlay"><span>✨ ${img.category}</span></div>
            `;
            galleryGrid.appendChild(item);
        });

        // Event listener untuk lightbox
        const items = document.querySelectorAll('.gallery-item');
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightboxImg');
        const closeLightbox = document.getElementById('closeLightbox');

        items.forEach(item => {
            item.addEventListener('click', (e) => {
                const imgSrc = item.querySelector('img').src;
                lightboxImg.src = imgSrc;
                lightbox.classList.add('active');
            });
        });

        closeLightbox.addEventListener('click', () => {
            lightbox.classList.remove('active');
        });
        lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) lightbox.classList.remove('active');
        });
    }

    // Animasi scroll reveal menggunakan Intersection Observer
    function initScrollReveal() {
        const items = document.querySelectorAll('.gallery-item');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('revealed');
                    observer.unobserve(entry.target); // sekali muncul saja
                }
            });
        }, { threshold: 0.2, rootMargin: "0px 0px -20px 0px" }); // sedikit offset

        items.forEach(item => observer.observe(item));
    }

    // Render galeri setelah DOM siap
    document.addEventListener('DOMContentLoaded', () => {
        renderGallery();
        initScrollReveal();
    });
</script>
</body>
</html>
